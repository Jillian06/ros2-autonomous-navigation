<?xml version="1.0"?>
<sdf version="1.9"><model name="lsy_bot"><pose>0 0 0.18 0 0 0</pose>
<link name="base_link"><inertial><mass>5</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.10</izz></inertia></inertial><collision name="c"><geometry><box><size>0.45 0.32 0.18</size></box></geometry></collision><visual name="v"><geometry><box><size>0.45 0.32 0.18</size></box></geometry></visual></link>
<link name="left_wheel"><pose>0 0.19 -0.08 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual></link>
<link name="right_wheel"><pose>0 -0.19 -0.08 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual></link>
<joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
<joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis></joint>
<link name="lidar"><pose>0.12 0 0.15 0 0 0</pose><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>10</max><resolution>0.01</resolution></range></ray><always_on>true</always_on></sensor></link>
<joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar</child></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.38</wheel_separation><wheel_radius>0.09</wheel_radius><topic>cmd_vel</topic><odom_topic>odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id></plugin>
</model></sdf>

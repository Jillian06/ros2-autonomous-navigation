<?xml version="1.0"?>
<sdf version="1.9"><model name="autonomy_bot"><pose>0 0 0.18 0 0 0</pose>
<link name="base_link"><inertial><mass>5</mass><inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.10</izz></inertia></inertial><collision name="c"><geometry><box><size>0.45 0.32 0.18</size></box></geometry></collision><visual name="v"><geometry><box><size>0.45 0.32 0.18</size></box></geometry><material><ambient>1 0.35 0.05 1</ambient><diffuse>1 0.35 0.05 1</diffuse></material></visual></link>
<link name="left_wheel"><pose>0 0.19 -0.08 1.5708 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.00043</ixx><iyy>0.00043</iyy><izz>0.00081</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual></link>
<link name="right_wheel"><pose>0 -0.19 -0.08 1.5708 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.00043</ixx><iyy>0.00043</iyy><izz>0.00081</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry></visual></link>
<joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
<link name="front_support"><pose>0.18 0 -0.13 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.000032</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="v"><geometry><sphere><radius>0.04</radius></sphere></geometry></visual></link>
<joint name="front_support_joint" type="fixed"><parent>base_link</parent><child>front_support</child></joint>
<link name="rear_support"><pose>-0.18 0 -0.13 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.000032</ixx><iyy>0.000032</iyy><izz>0.000032</izz></inertia></inertial><collision name="c"><geometry><sphere><radius>0.04</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="v"><geometry><sphere><radius>0.04</radius></sphere></geometry></visual></link>
<joint name="rear_support_joint" type="fixed"><parent>base_link</parent><child>rear_support</child></joint>
<link name="lidar"><pose>0.12 0 0.15 0 0 0</pose><sensor name="lidar" type="gpu_lidar"><topic>scan</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>10</max><resolution>0.01</resolution></range></ray><always_on>true</always_on></sensor></link>
<joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar</child></joint>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.38</wheel_separation><wheel_radius>0.09</wheel_radius><topic>cmd_vel</topic><odom_topic>/wheel_odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id></plugin>
<plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_topic>/ground_truth</odom_topic><odom_frame>odom</odom_frame><robot_base_frame>base_link</robot_base_frame><dimensions>2</dimensions><odom_publish_frequency>50</odom_publish_frequency></plugin>
</model></sdf>
